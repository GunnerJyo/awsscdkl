{
  "name": "aws-student-community-day-keralam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "build:prototype": "npm run typecheck && vite build --outDir dist-prototype && node scripts/prerender.mjs --prototype",
    "preview": "node scripts/serve.mjs",
    "preview:prototype": "node scripts/serve.mjs --prototype",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.3.0",
    "typescript": "~5.9.3",
    "playwright": "^1.56.0"
  }
}
